<?xml version="1.0" encoding="UTF-8"?>
<RECIPES>
  <RECIPE>
    <NAME>Dry Irish Stout</NAME>
    <VERSION>1</VERSION>
    <TYPE>Beer</TYPE>
    <STYLE>
      <NAME>Dry Irish Stout</NAME>
      <VERSION>1</VERSION>
      <CATEGORY>Stout</CATEGORY>
      <CATEGORY_NUMBER>15</CATEGORY_NUMBER>
      <STYLE_LETTER>A</STYLE_LETTER>
      <EXAMPLES>Guinness Draught, Murphy's Stout</EXAMPLES>
    </STYLE>
    <BATCH_SIZE>19</BATCH_SIZE>
    <BOIL_SIZE>22</BOIL_SIZE>
    <BOIL_TIME>60</BOIL_TIME>
    <EFFICIENCY>70</EFFICIENCY>
    <OG>1.044</OG>
    <FG>1.007</FG>
    <COLOR>38</COLOR>
    <IBU>38</IBU>
    <ABV>4.8</ABV>
    <FERMENTABLES>
      <FERMENTABLE>
        <NAME>Maris Otter</NAME>
        <VERSION>1</VERSION>
        <AMOUNT>4000</AMOUNT>
        <YIELD>80</YIELD>
        <COLOR>4</COLOR>
        <TYPE>Grain</TYPE>
      </FERMENTABLE>
      <FERMENTABLE>
        <NAME>Roasted Barley</NAME>
        <VERSION>1</VERSION>
        <AMOUNT>400</AMOUNT>
        <YIELD>70</YIELD>
        <COLOR>500</COLOR>
        <TYPE>Grain</TYPE>
      </FERMENTABLE>
    </FERMENTABLES>
    <HOPS>
      <HOP>
        <NAME>Fuggle</NAME>
        <VERSION>1</VERSION>
        <ALPHA>4.5</ALPHA>
        <AMOUNT>40</AMOUNT>
        <USE>Boil</USE>
        <TIME>60</TIME>
      </HOP>
    </HOPS>
    <YEASTS>
      <YEAST>
        <NAME>Safale S-04</NAME>
        <VERSION>1</VERSION>
        <FORM>Dry</FORM>
        <AMOUNT>11.5</AMOUNT>
        <ATTENUATION>75</ATTENUATION>
      </YEAST>
    </YEASTS>
    <NOTES>Classic dry stout: pale base malt plus a large roasted barley charge for the dry, coffee-like finish. Serve on nitrogen if you can.</NOTES>
  </RECIPE>
  <RECIPE>
    <NAME>Oatmeal Stout</NAME>
    <VERSION>1</VERSION>
    <TYPE>Beer</TYPE>
    <STYLE>
      <NAME>Oatmeal Stout</NAME>
      <VERSION>1</VERSION>
      <CATEGORY>Stout</CATEGORY>
      <CATEGORY_NUMBER>15</CATEGORY_NUMBER>
      <STYLE_LETTER>C</STYLE_LETTER>
      <EXAMPLES>Samuel Smith's Oatmeal Stout</EXAMPLES>
    </STYLE>
    <BATCH_SIZE>19</BATCH_SIZE>
    <BOIL_SIZE>23</BOIL_SIZE>
    <BOIL_TIME>60</BOIL_TIME>
    <EFFICIENCY>72</EFFICIENCY>
    <OG>1.058</OG>
    <FG>1.014</FG>
    <COLOR>34</COLOR>
    <IBU>30</IBU>
    <ABV>5.8</ABV>
    <FERMENTABLES>
      <FERMENTABLE>
        <NAME>Pale 2-Row</NAME>
        <VERSION>1</VERSION>
        <AMOUNT>4200</AMOUNT>
        <YIELD>78</YIELD>
        <COLOR>3</COLOR>
        <TYPE>Grain</TYPE>
      </FERMENTABLE>
      <FERMENTABLE>
        <NAME>Flaked Oats</NAME>
        <VERSION>1</VERSION>
        <AMOUNT>750</AMOUNT>
        <YIELD>70</YIELD>
        <COLOR>2</COLOR>
        <TYPE>Grain</TYPE>
      </FERMENTABLE>
      <FERMENTABLE>
        <NAME>Chocolate Malt</NAME>
        <VERSION>1</VERSION>
        <AMOUNT>300</AMOUNT>
        <YIELD>68</YIELD>
        <COLOR>350</COLOR>
        <TYPE>Grain</TYPE>
      </FERMENTABLE>
      <FERMENTABLE>
        <NAME>Crystal 60L</NAME>
        <VERSION>1</VERSION>
        <AMOUNT>300</AMOUNT>
        <YIELD>74</YIELD>
        <COLOR>60</COLOR>
        <TYPE>Grain</TYPE>
      </FERMENTABLE>
    </FERMENTABLES>
    <HOPS>
      <HOP>
        <NAME>Kent Goldings</NAME>
        <VERSION>1</VERSION>
        <ALPHA>4.0</ALPHA>
        <AMOUNT>35</AMOUNT>
        <USE>Boil</USE>
        <TIME>60</TIME>
      </HOP>
    </HOPS>
    <YEASTS>
      <YEAST>
        <NAME>Safale US-05</NAME>
        <VERSION>1</VERSION>
        <FORM>Dry</FORM>
        <AMOUNT>11.5</AMOUNT>
        <ATTENUATION>78</ATTENUATION>
      </YEAST>
    </YEASTS>
    <NOTES>Flaked oats give a fuller, silky body. Keep the roasted malt modest so the oat character shows. Ferment at 18-20 C.</NOTES>
  </RECIPE>
</RECIPES>
